  "devDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "playwright": "^1.62.1",
    "tsx": "^4.23.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6"
  }

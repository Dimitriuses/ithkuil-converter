    "quaternary-test": "tsx src/quaternary-roundtrip.ts",
    "tertiary-test": "tsx src/tertiary-roundtrip.ts",
    "primary-test": "tsx src/primary-roundtrip.ts",
    "primary-align-test": "tsx src/primary-aligned-roundtrip.ts",
    "formative-test": "tsx src/formative-roundtrip.ts",
    "word": "tsx src/word-demo.ts",
    "secondary-test": "tsx src/secondary-roundtrip.ts",
    "word-test": "tsx src/word-roundtrip.ts",
    "lexicon-test": "tsx src/lexicon-roundtrip.ts",
    "scan-sheet": "tsx src/scan-sheet.ts",
    "scan-ingest": "tsx src/scan-ingest.ts",
    "scan-test": "tsx src/scan-test.ts",
    "phrase-test": "tsx src/phrase-roundtrip.ts",
    "case-test": "tsx src/case-roundtrip.ts",
    "vrvv-test": "tsx src/vrvv-roundtrip.ts",
    "tricon-test": "tsx src/tricon-roundtrip.ts",
    "alphabetic": "tsx src/alphabetic-test.ts",
    "cnn": "tsx src/cnn.ts",
    "cnn-primary": "tsx src/cnn-primary.ts",
    "cnn-top": "tsx src/cnn-top.ts",
    "cnn-alpha": "tsx src/cnn-alpha.ts",
    "cnn-secondary": "tsx src/cnn-secondary.ts",
    "cnn-infer": "tsx src/cnn-infer-test.ts",
    "secondary-cnn": "tsx src/secondary-cnn-test.ts"
